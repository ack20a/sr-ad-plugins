[Rule]
DOMAIN,180.76.76.200,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/tiebac\.baidu\.com\/c\/f\/forum\/getInterestClassList$ - reject-dict

^https?:\/\/tiebac\.baidu\.com\/c\/f\/search\/discover$ - reject-dict
^https?:\/\/tieba\.baidu\.com\/c\/f\/search\/discover$ - reject-dict

^https:\/\/tieba\.baidu\.com\/c\/f\/forum\/getForumAlbum$ - reject-dict

^http:\/\/c\.tieba\.baidu\.com\/c\/f\/forum\/hotforum$ - reject-dict

[Body Rewrite]
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ 'if type == "object" then delpaths([["activity_switch"],["video_report_config"],["advertisement_config"],["next_start"],["push_strategy_new"],["live_activity_guide"],["h5_pop_ups"],["duxiaoman_url"],["is_need_remind_live_rooms"],["floating_icon"],["ad_stlog_switch"],["first_time_motivate"],["windowStrategyList"],["ad_adsense"],["ad_config"],["videoup_guide_pop"],["ad_origin_config_switch"],["needNewUserLead"],["h5_pop_ups_config"],["alaTabColor"],["search_guide"],["ad_sdk_priority"],["low_version_pop_config"],["ad_num_competition_frs"],["live_new_user_guide_day"],["screen_fill_data_result"],["yy_live_tab"],["ad_num_competition_personalize"],["complete_apk_url"],["user_activity"],["homepage_guide"],["bottom_bubble_config"],["home_screen_ad"],["afSearch_tab"],["recent_client_info"],["video_activity"],["namoaixud_url"],["yy_live_config"],["user_growth_task_list"],["cloud_control_data_info"]]) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" then delpaths([["wl_config","pb_banner_funad_cache_strategy"],["wl_config","pb_comment_asyncafd_cache_strategy"],["wl_config","download_edge_float"],["wl_config","download_pause_retain_dialog_conf"],["wl_config","download_mobile_dialog_conf"],["wl_config","download_fake_progress_config_a"],["wl_config","download_fake_progress_config_b"]]) else . end | if type == "object" then delpaths([["scheme_whitelist"]]) else . end'

http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ 'if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("home_ad_num")) then setpath(["wl_config","home_ad_num"]; 0) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("frs_ad_num")) then setpath(["wl_config","frs_ad_num"]; 0) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("pb_comment_ad_num")) then setpath(["wl_config","pb_comment_ad_num"]; 0) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("index_bear_density")) then setpath(["wl_config","index_bear_density"]; 0) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("frs_bear_density")) then setpath(["wl_config","frs_bear_density"]; 0) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("index_bear_first_floor_max")) then setpath(["wl_config","index_bear_first_floor_max"]; 999999999) else . end | if type == "object" and (getpath(["wl_config"]) | type) == "object" and (getpath(["wl_config"]) | has("index_bear_first_floor_min")) then setpath(["wl_config","index_bear_first_floor_min"]; 999999999) else . end'

http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ '.index_tab_info |= map(select(.tab_name == "推荐")) | .top_level_navi |= {"推荐": .["推荐"], "侧边栏": .["侧边栏"], "关注": .["关注"]}'

http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ 'if type == "object" then delpaths([["url_map"],["user_agent_info"],["bubble_info"],["duxiaoman_entry"],["uc_card"],["finance_tab"],["vip_banner"],["ala_live_info"],["recom_naws_list"],["duxiaoman"]]) else . end | if type == "object" and (getpath(["user"]) | type) == "object" then delpaths([["user","consume_info"]]) else . end | if type == "object" then delpaths([["namoaixud_entry"]]) else . end'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ 'if type == "object" and (getpath(["user"]) | type) == "object" and (getpath(["user","shake_ad_switch"]) | type) == "object" and (getpath(["user","shake_ad_switch"]) | has("is_show")) then setpath(["user","shake_ad_switch","is_show"]; 0) else . end'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ '.custom_grid |= map(select(.title != "游戏大厅" and .title != "预约管理" and .title != "领话费" and .title != "短故事")) | .zone_info |= map(.common_func |= (if .common_func_noraml then .common_func_noraml |= map(select(.name != "创建智能体")) else . end)) | .zone_info |= map(select(.type != "commerce" and .type != "banner" and .type != "game"))'

http-response-jq ^https?:\/\/tieba\.baidu\.com\/c\/f\/forum\/forumGuide$ 'if type == "object" then delpaths([["hot_search"]]) else . end'

http-response-jq ^https?:\/\/tieba\.baidu\.com\/c\/f\/frs\/frsBottom\? 'if type == "object" then delpaths([["card_activity"]]) else . end'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/f\/frs\/frsBottom$ 'if type == "object" then delpaths([["card_activity"]]) else . end'

http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/f\/sidebar\/home$ 'if type == "object" then delpaths([["game_center"],["tools"],["task_list"],["vip_banner"]]) else . end'

[Map Local]
^https?:\/\/tieba\.baidu\.com\/mo\/q\/search\/startPage\? data-type=text data="{"no":0,"error":"success"}" header="Content-Type:application/json"

[Script]
ProtoBuf处理 = type=http-response,pattern=^https?:\/\/tieba(?:c)?\.baidu\.com\/c\/(f\/excellent\/personalized|f\/frs\/page|b\/ad\/adBid|f\/ad\/getFeedAd|f\/pb\/page|f\/frs\/generalTabList)\?cmd=\d+&format=protobuf,requires-body=1,binary-body-mode=1,script-path=https://kelee.one/Resource/JavaScript/Tieba/tieba-proto.js,timeout=10,max-size=-1,argument="per_filter_video_thread={{{per_filter_video_thread}}}"

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
