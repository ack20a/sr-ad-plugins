[Rule]
DOMAIN,180.76.76.200,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/tiebac\.baidu\.com\/c\/f\/forum\/getInterestClassList$ - reject-dict

# [DISABLED: Shadowrocket 下拦截 search/discover 会导致贴吧登录后被踢出] ^https?:\/\/tiebac\.baidu\.com\/c\/f\/search\/discover$ - reject-dict
# [DISABLED: Shadowrocket 下拦截 search/discover 会导致贴吧登录后被踢出] ^https?:\/\/tieba\.baidu\.com\/c\/f\/search\/discover$ - reject-dict

^https:\/\/tieba\.baidu\.com\/c\/f\/forum\/getForumAlbum$ - reject-dict

^http:\/\/c\.tieba\.baidu\.com\/c\/f\/forum\/hotforum$ - reject-dict

[Body Rewrite]







[Map Local]
^https?:\/\/tieba\.baidu\.com\/mo\/q\/search\/startPage\? data-type=text data="{"no":0,"error":"success"}" header="Content-Type:application/json"

[Script]
ProtoBuf处理 = type=http-response,pattern=^https?:\/\/tieba(?:c)?\.baidu\.com\/c\/(f\/excellent\/personalized|f\/frs\/page|b\/ad\/adBid|f\/ad\/getFeedAd|f\/pb\/page|f\/frs\/generalTabList)\?cmd=\d+&format=protobuf,requires-body=1,binary-body-mode=1,script-path=https://kelee.one/Resource/JavaScript/Tieba/tieba-proto.js,timeout=10,argument="per_filter_video_thread={{{per_filter_video_thread}}}"

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
